  {
    "id": "disable_action_button",
    "type": "checkbox",
    "label": {
      "en": "Disable action button",
      "nl": "Blokeer actie knop",
	  "de": "Deaktiviert die Taste am Gerät"
    },
    "zwave": {
      "index": 96,
      "size": 1
    },
    "hint": {
      "en": "This disables the action button, so that it won't activate an alarm anymore.",
      "nl": "Dit blokeerd de actie knop, zodat deze geen alarm kan activeren.",
	  "de": "Dadurch wird die Taste am Gerät deaktiviert, so dass sie keinen Alarm mehr auslöst."
    },
    "value": false
  },
