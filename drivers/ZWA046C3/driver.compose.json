		"button.reset_meter_apparent_export"
		],
   
    "capabilitiesOptions": {
	
	
    "button.reset_meter_import": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset power meter consumption",
		"de": "Verbrauchsmesswerte zurücksetzen "
      },
      "desc": {
        "en": "Reset the accumulated power usage (kWh), note that this can not be reversed.",
		"de": "Setzen Sie den kumulierten Stromverbrauch (kWh) zurück. Beachten Sie, dass dies nicht rückgängig gemacht werden kann."
      }
    },
	"button.reset_meter_export": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset power meter production",
		"de": "Produktionsmesswerte zurücksetzen "
      },
      "desc": {
        "en": "Reset the cumulative value for power generation (kWh). Please note that this cannot be undone.",
		"de": "Setzen Sie den kumulierten Wert für Stromerzeugung (kWh) zurück. Beachten Sie, dass dies nicht rückgängig gemacht werden kann."
      }
    },
	"button.reset_meter_apparent_import": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset total power values (import)",
		"de": "Gesamt Leistungswerte zurücksetzen (Verbrauch)"
      },
      "desc": {
        "en": "Resets the cumulative reactive and apparent power (kVAh, kVARh). This cannot be reversed.",
		"de": "Setzt den kumulierte Blind und Scheinleistung (kVAh, kVARh) zurück. Dies kann nicht rückgängig gemacht werden."
      }
    },
	"button.reset_meter_apparent_export": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset total power values (export)",
		"de": "Gesamt Leistungswerte zurücksetzen (Produktion)"
      },
      "desc": {
        "en": "Resets the cumulative reactive and apparent power (kVAh, kVARh). This cannot be reversed.",
		"de": "Setzt den kumulierte Blind und Scheinleistung (kVAh, kVARh) zurück. Dies kann nicht rückgängig gemacht werden."
      }
    }
  },

		
