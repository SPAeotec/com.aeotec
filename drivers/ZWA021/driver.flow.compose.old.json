						{
							"id": "unprotected",
							"label": {
								"en": "Unprotected",
								"nl": "Onbeveiligd",
								"de": "Ungesichert"
							}
						},
						{
							"id": "unlockable",
							"label": {
								"en": "Unlockable protected",
								"nl": "Ontgrendelbaar beveiligd",
								"de": "Entsperrbar gesichert"
							}
						},
						{
							"id": "protected",
							"label": {
								"en": "Protected",
								"nl": "Beveiligd",
								"de": "Gesperrt"
								
							}
						}
					]
				}
			]
		},
		{
			"id": "spirit_external_temperature",
			"platforms": [ "local", "cloud" ],
