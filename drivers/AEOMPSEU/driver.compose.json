{
    "id": "AeotecMulti",
	"platforms": [ "local", "cloud" ],
    "name": {
      "en": "Multipurpose Sensor (IM6001) Aeotec SmartThings",
	  "de": "Multifunktionssensor (IM6001) Aeotec SmartThings)"
    },
    "class": "sensor",
    "capabilities": [
      "measure_battery",
      "alarm_contact",
      "measure_temperature"
    ],
    "energy": {
      "batteries": [ "CR2450" ]
    },
	"connectivity": ["zigbee"],
    "zigbee": {
      "manufacturerName":[ 
	  "Samjin",
	  "SmartThings"
	  ],
      "productId": [
        "multi",
		"multiv4"
      ],        
      "deviceId": 1026,
      "profileId": 260,
      "endpoints": {
        "1": {
          "clusters": [0, 1, 1026, 1280],
          "bindings": [0, 1, 1026, 1280]
        }
      },
      "learnmode": {
	  "image": "{{driverAssetsPath}}/learnmode.svg",
      "instruction": {
        "en": "Use a pin to press the button on the contact side of the sensor for 5 seconds.",
		"de": "Drücken Sie mit einem Pin den Taster an der Kontaktseite des Sensors für 5 Sekunden."
      }
    }	  
    },
    "images": {
      "large": "/drivers/AEOMPSEU/assets/images/large.png",
      "small": "/drivers/AEOMPSEU/assets/images/small.png"
    }
  }